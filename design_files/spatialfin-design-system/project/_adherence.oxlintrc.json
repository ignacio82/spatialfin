        "selector": "JSXOpeningElement[name.name='ServerEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|address|currentUser|key|ref|className|style|children)$/]",
        "message": "<ServerEntry> doesn't accept that prop. Declared props: id, name, address, currentUser."

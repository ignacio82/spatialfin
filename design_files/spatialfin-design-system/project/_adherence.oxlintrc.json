        "selector": "JSXOpeningElement[name.name='PosterCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|poster|progress|badge|width|showFooter|onClick|key|ref|className|style|children)$/]",
        "message": "<PosterCard> doesn't accept that prop. Declared props: title, subtitle, poster, progress, badge, width, showFooter, onClick."
      },

{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/media/**",
              "components/music/**",
              "components/navigation/**",
              "components/onboarding/**",
              "components/surfaces/**",
              "components/tv/**",
              "components/voice/**",
              "ui_kits/beam/**",
              "ui_kits/tv/**",
              "ui_kits/xr/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Roboto|Roboto Mono))/i]",
        "message": "Font not provided by the design system. Available: Roboto, Roboto Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|dot|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, icon, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|neutral|error|success|overlay)$/]",
        "message": "<Badge> tone must be one of 'accent' | 'neutral' | 'error' | 'success' | 'overlay'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|fullWidth|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, fullWidth, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filled|tonal|outlined|text|glass)$/]",
        "message": "<Button> variant must be one of 'filled' | 'tonal' | 'outlined' | 'text' | 'glass'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EpisodeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|still|runtime|synopsis|progress|width|onClick|focusFirst|style|key|ref|className|style|children)$/]",
        "message": "<EpisodeCard> doesn't accept that prop. Declared props: number, title, still, runtime, synopsis, progress, width, onClick, focusFirst, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FocusCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|image|orientation|width|progress|badge|onClick|focusFirst|style|key|ref|className|style|children)$/]",
        "message": "<FocusCard> doesn't accept that prop. Declared props: title, subtitle, image, orientation, width, progress, badge, onClick, focusFirst, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FocusCard'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:portrait|landscape)$/]",
        "message": "<FocusCard> orientation must be one of 'portrait' | 'landscape'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|radius|padding|children|key|ref|className|style|children)$/]",
        "message": "<GlassPanel> doesn't accept that prop. Declared props: tone, radius, padding, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:panel|strong)$/]",
        "message": "<GlassPanel> tone must be one of 'panel' | 'strong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:md|lg|full)$/]",
        "message": "<GlassPanel> radius must be one of 'md' | 'lg' | 'full'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<GlassPanel> padding must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|kind|backdrop|meta|height|actions|rounded|key|ref|className|style|children)$/]",
        "message": "<HeroBanner> doesn't accept that prop. Declared props: title, kind, backdrop, meta, height, actions, rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|variant|size|label|disabled|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, variant, size, label, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:tonal|filled|ghost|glass|outlined)$/]",
        "message": "<IconButton> variant must be one of 'tonal' | 'filled' | 'ghost' | 'glass' | 'outlined'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MaTrack'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|artist|artwork|key|ref|className|style|children)$/]",
        "message": "<MaTrack> doesn't accept that prop. Declared props: title, artist, artwork."
      },
      {
        "selector": "JSXOpeningElement[name.name='MaPlayer'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|provider|isPlaying|supportsGrouping|syncedToPlayerId|groupMemberIds|canGroupWith|key|ref|className|style|children)$/]",
        "message": "<MaPlayer> doesn't accept that prop. Declared props: id, name, provider, isPlaying, supportsGrouping, syncedToPlayerId, groupMemberIds, canGroupWith."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|icon|label|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: id, icon, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrbiterItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|onClick|active|key|ref|className|style|children)$/]",
        "message": "<OrbiterItem> doesn't accept that prop. Declared props: icon, label, onClick, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: tone, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:chip|neutral|accent|outline|rating)$/]",
        "message": "<Pill> tone must be one of 'chip' | 'neutral' | 'accent' | 'outline' | 'rating'."
      },

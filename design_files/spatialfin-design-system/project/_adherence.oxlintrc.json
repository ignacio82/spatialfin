        "selector": "JSXOpeningElement[name.name='TvTopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:serverName|logoSrc|user|isLoading|isError|onServerClick|onErrorClick|onRetryClick|onSearchClick|onSettingsClick|onUserClick|onCloseClick|style|key|ref|className|style|children)$/]",
